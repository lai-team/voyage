root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# WordPress coding standards. Note that existing indentation is inconsistent:
# voyage.php is tab-indented, several files under includes/ use four spaces.
# Nothing has been reformatted, so expect mixed style until a file is rewritten.
[*.{php,js}]
indent_style = tab

[*.css]
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
